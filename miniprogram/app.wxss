/*!
 * app.wxss — 全局样式与设计令牌（与网页版视觉保持一致）
 */

page {
  /* 主题变量：由 theme.json 的 light / dark 注入 */
  --bg: var(--pageBg, #fff8ef);
  --surface-color: var(--surface, #ffffff);
  --surface-soft: var(--surfaceSoft, rgba(255, 255, 255, 0.6));
  --border-color: var(--border, rgba(96, 62, 24, 0.12));
  --text-color: var(--text, #2f2013);
  --text-muted: var(--textMuted, #7a6551);
  --accent-color: var(--accent, #f2704a);
  --accent2-color: var(--accent2, #ffa84c);
  --accent-ink: var(--accentInk, #ffffff);
  --good-color: var(--good, #3f9d52);
  --bad-color: var(--bad, #d64545);

  --radius-sm: 16rpx;
  --radius-md: 28rpx;
  --radius-lg: 40rpx;
  --radius-pill: 999rpx;

  height: 100%;
  background: var(--bg);
  color: var(--text-color);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, button, canvas, image { box-sizing: border-box; }

/* 按钮：小程序 button 默认样式较重，这里统一重置 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border: 0;
  margin: 0;
  transition: transform 0.12s ease-out, opacity 0.12s ease-out;
}
.btn::after { border: 0; }
.btn:active { transform: scale(0.96); }

.btn-primary {
  background: linear-gradient(140deg, var(--accent2-color), var(--accent-color));
  color: var(--accent-ink);
  box-shadow: 0 6rpx 20rpx rgba(96, 62, 24, 0.16);
}
.btn-soft {
  background: var(--surface-color);
  color: var(--text-color);
  border: 2rpx solid var(--border-color);
}
.btn-ghost {
  background: var(--surface-soft);
  color: var(--text-muted);
}
.btn-block { width: 100%; }
.btn-sm { min-height: 68rpx; padding: 0 22rpx; font-size: 26rpx; }

/* 卡片 */
.card {
  background: var(--surface-color);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 30rpx rgba(96, 62, 24, 0.08);
}

/* 得分胶囊 */
.score-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 140rpx;
  padding: 10rpx 22rpx;
  border-radius: var(--radius-md);
  background: var(--surface-color);
  border: 2rpx solid var(--border-color);
}
.score-chip.is-muted { background: var(--surface-soft); }
.score-chip.is-hot { border-color: var(--accent-color); }
.chip-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  text-transform: uppercase;
}
.chip-value {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  color: var(--text-color);
}
.score-chip.is-muted .chip-value { font-weight: 600; color: var(--text-muted); }
.score-chip.is-hot .chip-value { color: var(--accent-color); }

/* 吐司 */
.toast {
  position: fixed;
  left: 50%;
  bottom: 220rpx;
  z-index: 60;
  max-width: 80%;
  padding: 18rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-color);
  border: 2rpx solid var(--border-color);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.16);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  color: var(--text-color);
  transform: translate(-50%, 20rpx);
  opacity: 0;
  transition: opacity 0.28s ease-out, transform 0.28s ease-out;
  pointer-events: none;
}
.toast.show { opacity: 1; transform: translate(-50%, 0); }
.toast.is-good { color: var(--good-color); }
.toast.is-warn { color: var(--bad-color); }

/* 弹窗 */
.modal-root {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.modal-scrim {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(16, 12, 8, 0.5);
}
.modal {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  max-height: 78vh;
  overflow-y: auto;
  padding: 40rpx;
  border-radius: var(--radius-lg);
  background: var(--pageBg, #fffdf8);
  border: 2rpx solid var(--border-color);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.28);
}
.modal-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 20rpx;
}
.modal-text {
  display: block;
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
}
.modal-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx;
  margin: 20rpx 0;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
}
.modal-score-value { font-size: 68rpx; font-weight: 800; color: var(--accent-color); line-height: 1; }
.modal-score-label { font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }
.modal-rows { display: flex; flex-direction: column; gap: 10rpx; }
.modal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--surface-soft);
  font-size: 28rpx;
}
.modal-row-value { font-weight: 800; }
.modal-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}
.modal-actions .btn { flex: 1 1 auto; min-width: 200rpx; }

/* 设置项通用 */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  border-bottom: 2rpx solid var(--border-color);
}
.set-label { font-size: 28rpx; font-weight: 600; }
.set-note {
  padding: 22rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}
.set-note-title { display: block; color: var(--text-color); font-weight: 700; margin-bottom: 6rpx; }

/* 分段控件 */
.segmented { display: flex; padding: 4rpx; border-radius: var(--radius-pill); background: var(--surface-soft); }
.seg-btn {
  padding: 10rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
}
.seg-btn.is-on { background: var(--surface-color); color: var(--text-color); }

.row { display: flex; align-items: center; }
.col { display: flex; flex-direction: column; }
.grow { flex: 1; }
.muted { color: var(--text-muted); }
.center { text-align: center; }
.emoji { font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif; }
