/* pages/index/index.wxss — 首页 */

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}

.decor {
  position: absolute;
  left: -20%;
  top: -10%;
  width: 140%;
  height: 60%;
  background: radial-gradient(closest-side, rgba(255, 168, 76, 0.28), rgba(255, 168, 76, 0));
  pointer-events: none;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 0 8rpx;
}
.hero-mark { font-size: 110rpx; line-height: 1; }
.hero-title { font-size: 48rpx; font-weight: 800; letter-spacing: -0.01em; }
.hero-sub { font-size: 24rpx; color: var(--text-muted); }

/* 模式卡片 */
.mode-grid { display: flex; flex-direction: column; gap: 24rpx; }

.mode-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
}
.card-hover { transform: translateY(-2rpx); border-color: var(--accent-color); }

.mode-emoji {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, var(--accent2-color), var(--accent-color));
  box-shadow: inset 0 -6rpx 14rpx rgba(0, 0, 0, 0.14);
}
.mode-text { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.mode-name { font-size: 34rpx; font-weight: 800; }
.mode-desc { font-size: 24rpx; color: var(--text-muted); }

.mode-best {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid var(--border-color);
}
.mode-best-label { font-size: 20rpx; color: var(--text-muted); letter-spacing: 0.06em; }
.mode-best-value { font-size: 32rpx; font-weight: 800; color: var(--accent-color); }

.continue { margin-top: 8rpx; }

.links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}
.link-btn {
  padding: 14rpx 26rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-soft);
  border: 2rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-muted);
}

.foot-note {
  margin-top: auto;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
}

/* 玩法说明 */
.howto { display: flex; flex-direction: column; gap: 20rpx; }
.howto-item {
  padding: 22rpx;
  border-radius: var(--radius-md);
  background: var(--surface-soft);
}
.howto-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.howto-head .emoji { font-size: 36rpx; }
.howto-name { font-size: 30rpx; font-weight: 700; }
.howto-rules { font-size: 25rpx; color: var(--text-muted); line-height: 1.6; }

.danger { color: var(--bad-color); margin-top: 24rpx; }
